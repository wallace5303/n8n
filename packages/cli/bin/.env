N8N_PROTOCOL="http"
# 将废弃，使用 N8N_LISTEN_ADDRESS 替代
# N8N_HOST=0.0.0.0
N8N_PORT=5679
# WEBHOOK_URL="http://n8n-fn60g.kaka996.com/"
# UI/OAuth 对外地址
# N8N_EDITOR_BASE_URL="http://n8n-fn60g.kaka996.com/"
# 底层监听，接收所有请求，
N8N_LISTEN_ADDRESS="::"
#HOST_IP=0.0.0.0
N8N_SECURE_COOKIE=false
NODE_FUNCTION_ALLOW_BUILTIN=*
# 设置 * 允许所有外部模块。但对原型扩展库无效；直接指定一个库会预加载，n8n 允许受控的原型修改
# 如 dayjs, crawlee
NODE_FUNCTION_ALLOW_EXTERNAL=*
N8N_LOG_OUTPUT=file
N8N_LOG_FILE_LOCATION="/Users/gsx/.n8n-latest/n8n.log"
GENERIC_TIMEZONE='Asia/Shanghai'
TZ='Asia/Shanghai'
# Use local .n8n directory
N8N_USER_FOLDER="/Users/gsx/.n8n-latest"
# 在 Node.js 环境中访问环境变量
N8N_BLOCK_ENV_ACCESS_IN_NODE=true
# 允许任意 Origin 的 WebSocket 连接，解决 1008 政策违规错误
N8N_PUSH_ORIGIN='*'
# 禁用跨站请求伪造保护
N8N_CSRF_DISABLED=true
# 禁用 HTTP 严格传输安全头
N8N_HSTS_DISABLED=true
# 强制使用 WebSocket 而非 SSE (Server-Sent Events)
N8N_PUSH_BACKEND=websocket
# 增加代理设置，允许 n8n 通过代理服务器访问外部资源
HTTP_PROXY=http://127.0.0.1:10808
HTTPS_PROXY=http://127.0.0.1:10808
NO_PROXY=localhost,127.0.0.1,n8n-fn60g.kaka996.com
# crawlee 缓存目录，实际为 执行 n8n bin 脚本的目录
# CRAWLEE_STORAGE_DIR="./tmp/crawlee"
# 阻止某些节点，使其不可用。设置为空表示不阻止任何节点。
NODES_EXCLUDE="[]"
# 设置为空字符串，它会禁用文件访问限制，允许 ReadWriteFile 和 ReadBinaryFiles 节点访问任何目录
N8N_RESTRICT_FILE_ACCESS_TO=""

# Disable sandbox for Electron
# N8N_ELECTRON_DISABLE_SANDBOX=true
# Disable sandbox for webhook iframes
# N8N_INSECURE_DISABLE_WEBHOOK_IFRAME_SANDBOX=true
